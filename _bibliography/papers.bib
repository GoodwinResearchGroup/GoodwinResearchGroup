@article{10.1021/jacs.6c15081,
    author = {Smith, Bailee R. and Goodwin, Rosemary J. and White, Nicholas G.},
    title = {Simultaneous
Selective Recognition of Two Different
Anions within a Hydrogen/Halogen-Bonding Cage},
    journal = {Journal of the American Chemical Society},
    year = {2026},
    month = {11},
    abstract = {The
search for selective anion receptors that can function in water
is a longstanding challenge in supramolecular chemistry, motivated
by anions’ fundamental roles (and potential applications) in
biological, environmental, and industrial processes. Here, we incorporate
halogen and hydrogen bond donors into an easy-to-prepare organic cage
molecule and demonstrate that this can bind anions at either or both
of a halogen-bonding pocket and hydrogen-bonding pockets depending
on the nature of the anions and the solvent. The halogen-bonding pocket
comprising six bromopyridinium donors is a potent host for iodide
anions and can selectively bind this guest in water as strongly as
biological iodide binders (Ka = 43,000
M–1 measured by 1H NMR spectroscopy)
with the exclusion of other halide anions. In DMSO/water mixtures,
the hydrogen-bonding pockets are able to recognize chloride anions,
resulting in the formation of mixed anion iodide/chloride complexes
with an iodide bound in the center of the cage and chlorides in the
peripheral binding sites. This demonstrates the exquisite selectivity
afforded by halogen-bonding systems and reveals a general route to
a range of supramolecular anion hosts that bind multiple guests in
different locations.},
    issn = {0002-7863},
    doi = {10.1021/jacs.6c15081},
    url = {https://doi.org/10.1021/jacs.6c15081},
    eprint = {https://pubs.acs.org/jacsat/article-pdf/doi/10.1021/jacs.6c15081/69165214/jacs.6c15081.pdf},
}





@article{10.1021/jacs.4c09930,
    author = {Foyle, Émer
M. and Goodwin, Rosemary J. and Cox, Cameron J. T. and Smith, Bailee R. and Colebatch, Annie L. and White, Nicholas G.},
    title = {Expedient Decagram-Scale
Synthesis of Robust Organic
Cages That Bind Sulfate Strongly and Selectively in Water},
    journal = {Journal of the American Chemical Society},
    volume = {146},
    number = {39},
    pages = {27127-27137},
    year = {2024},
    month = {10},
    abstract = {Selective anion recognition remains a key challenge in
supramolecular
chemistry: only a very small number of systems that can function in
water are known, and these nearly always preferentially bind hydrophobic
anions. In this work, we report three robust hexa-cationic cages that
can be prepared on scales up to 14 g in two simple and high-yielding
steps from commercially available materials. One of these cages displays
unusually strong sulfate binding in water (Ka = 12,000 M–1), and demonstrates high selectivity
for this anion over H2PO4–/HPO42– in DMSO/buffer mixtures. These
results demonstrate that relatively large, three-dimensional supramolecular
hosts can be prepared in high yields and on large scales, and can
be highly potent receptors.},
    issn = {0002-7863},
    doi = {10.1021/jacs.4c09930},
    url = {https://doi.org/10.1021/jacs.4c09930},
    eprint = {https://pubs.acs.org/jacsat/article-pdf/146/39/27127/16366173/ja4c09930.pdf},
}



